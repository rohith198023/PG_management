# Database Configuration (PostgreSQL / Supabase IPv4 Pooler)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_publishable_anon_key"
SUPABASE_SECRET_KEY="your_service_role_secret_key"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"

# JWT Authentication (Min 32 random characters in production)
JWT_SECRET="your-super-secret-jwt-token-key-min-32-chars-long"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Notifications - Email (SendGrid / SMTP)
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="notifications@yourdomain.com"

# Notifications - SMS & WhatsApp (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Automated Jobs & Security
CRON_SECRET="your-secure-cron-bearer-token"
PAYMENT_SECRET_KEY="pg_sas_encryption_key_32bytes_here!"

# App URLs
NEXT_PUBLIC_APP_URL="https://app.pgsas.in"
NODE_ENV="production"
